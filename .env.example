# --- Database -------------------------------------------------------------
# Local dev runs MySQL in Docker (see docker-compose.yml).
DATABASE_URL="mysql://portfolio:portfolio@localhost:3306/portfolio"

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"

# --- Seed admin (used by `npm run db:seed` only) --------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Cloudinary -----------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"