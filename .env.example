# --- Database -------------------------------------------------------------
# Host port for the compose `db` service. Change it if 5432 is already in use.
POSTGRES_PORT=5432
# Must match the POSTGRES_* values below.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
DATABASE_URL="postgresql://portfolio:portfolio@127.0.0.1:5432/portfolio"

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"

# --- Seed admin (used by `npm run db:seed` only) --------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Cloudinary -----------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host port for the compose `app` service. Change it if 3000 is already in use.
APP_PORT=3000