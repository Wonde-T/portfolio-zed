# --- Database -------------------------------------------------------------
# Host port for the compose `db` service. Change it if 3306 is already in use.
MYSQL_PORT=3306
# Must match the MYSQL_* values below.
MYSQL_DATABASE=portfolio
MYSQL_USER=portfolio
MYSQL_PASSWORD=portfolio
MYSQL_ROOT_PASSWORD=portfolio-root
DATABASE_URL="mysql://portfolio:portfolio@127.0.0.1:3306/portfolio"

# --- Auth -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"

# --- Seed admin (used by `npm run db:seed` only) --------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Cloudinary -----------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Host port for the compose `app` service. Change it if 3000 is already in use.
APP_PORT=3000